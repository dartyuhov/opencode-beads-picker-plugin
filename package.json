{
  "name": "opencode-beads-plugin",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "opencode.json",
    "tui.json"
  ],
  "engines": {
    "opencode": ">=1.18.23 <2.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/**/*.test.ts test/**/*.test.tsx",
    "test:tui": "bun test test/tui.test.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:tui && npm run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.23 <2.0.0",
    "@opentui/core": ">=0.4.5 <0.5.0",
    "@opentui/keymap": ">=0.4.5 <0.5.0",
    "@opentui/solid": ">=0.4.5 <0.5.0",
    "solid-js": ">=1.9.12 <2.0.0"
  }
}
