{
  "name": "opencode-beads-plugin",
  "version": "0.1.0",
  "description": "OpenCode plugin that adds a live Beads issue picker and enriched issue context.",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "opencode": ">=1.18.23 <2.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/**/*.test.ts test/**/*.test.tsx",
    "test:target": "node --test --import tsx test/target-runtime.test.ts",
    "test:tui": "bun test test/tui.test.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "verify": "npm run typecheck && npm test && npm run test:tui && npm run pack:check && npm run test:target"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.23 <2.0.0",
    "@opentui/core": ">=0.4.5 <0.5.0",
    "@opentui/keymap": ">=0.4.5 <0.5.0",
    "@opentui/solid": ">=0.4.5 <0.5.0",
    "solid-js": ">=1.9.12 <2.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "beads",
    "issue-tracker",
    "tui"
  ],
  "author": "dartyuhov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dartyuhov/opencode-beads-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/dartyuhov/opencode-beads-plugin/issues"
  },
  "homepage": "https://github.com/dartyuhov/opencode-beads-plugin#readme",
  "publishConfig": {
    "access": "public"
  }
}
